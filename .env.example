# ===== 服务配置 =====
NODE_ENV=development
SERVER_HOST=localhost
SERVER_PORT=3000

# ===== 数据库配置 =====
# 注意：数据层实际读取 SUDA_DATABASE_URL；DATABASE_URL 同时保留以兼容文档口径。
# 自建部署两者需填成同一个连接串。
DATABASE_URL=postgresql://username:password@localhost:5432/talent_review
SUDA_DATABASE_URL=postgresql://username:password@localhost:5432/talent_review

# ===== 平台运行时（自建必填，否则平台客户端构造即崩）=====
# 指向本服务自身地址即可。
FORCE_AUTHN_INNERAPI_DOMAIN=http://localhost:3000

# ===== 部署基础路径 =====
# 前端构建产物默认 basename 为 /app/。
#  - 保持默认：通过 http://localhost:3000/app/ 访问；
#  - 想在根路径访问：构建前显式设置 CLIENT_BASE_PATH=/ 并重新 build:client。
# CLIENT_BASE_PATH=/app/

# ===== JWT 密钥（生产环境必须使用强随机字符串）=====
AUTH_JWT_SECRET=your-jwt-secret-key-here-change-in-production

# ===== 管理员初始密码（首次启动使用，上线后请修改）=====
ADMIN_INITIAL_PASSWORD=admin123456

# ===== 日志配置 =====
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
