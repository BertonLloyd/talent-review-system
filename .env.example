# ===== 服务配置 =====
NODE_ENV=development
PORT=3000

# ===== 数据库配置（Drizzle 平台注入，自建部署时配置）=====
DATABASE_URL=postgresql://username:password@localhost:5432/talent_review

# ===== JWT 密钥（必须配置，生产环境请使用强随机字符串）=====
AUTH_JWT_SECRET=your-jwt-secret-key-here-change-in-production

# ===== 管理员初始密码（首次启动时使用，上线后请修改）=====
ADMIN_INITIAL_PASSWORD=admin123456

# ===== 日志配置 =====
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
